    },
    {
      "id": "f67_post_choice_bad",
      "type": "dialogue",
      "background": "bg_floor67_device",
      "dimAlpha": 0.7,
      "fadeDim": false,
      "fadeDuration": 0.0,
      "speaker": "%%",
