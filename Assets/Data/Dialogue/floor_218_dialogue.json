      "id": "f218_memory_017",
      "type": "dialogue",
      "background": "bg_floor218_lab_past",
      "dimAlpha": 0.25,
      "fadeDim": false,
      "fadeDuration": 0.0,
      "speaker": "이브",
      "text": "“괜찮아. 곧 나는 아무것도 느끼지 않게 될 거야.”",
      "leftCharacter": "",
      "rightCharacter": "eve_default",
      "sfx": "",
      "nextId": "f218_post_003"
