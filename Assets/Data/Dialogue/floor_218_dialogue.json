      "type": "dialogue",
      "background": "bg_floor218_lab",
      "dimAlpha": 0.25,
      "fadeDim": true,
      "fadeDuration": 0.8,
      "speaker": "카인",
      "text": "“이브가… 나를 살렸습니다…”",
      "leftCharacter": "player_default",
      "rightCharacter": "cain_k4",
      "sfx": "",
      "nextId": "f218_post_choice"
