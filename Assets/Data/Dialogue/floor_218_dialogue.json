      "id": "f218_memory_016",
      "type": "dialogue",
      "background": "bg_floor218_lab_past",
      "dimAlpha": 0.25,
      "fadeDim": false,
      "fadeDuration": 0.0,
      "speaker": "카인",
      "text": "“이브… 나는 무서워요.”",
      "leftCharacter": "",
      "rightCharacter": "cain_k4",
      "sfx": "",
      "nextId": "f218_memory_017"
    },
