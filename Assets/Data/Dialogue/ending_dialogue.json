{
  "startId": "ending_gameover_001",
  "nodes": [
    {
      "id": "ending_gameover_001",
      "type": "dialogue",
      "background": "bg_black",
      "dimAlpha": 0.7,
      "fadeDim": true,
      "fadeDuration": 1.0,
      "speaker": "시스템",
      "text": "에덴의 안전을 위협한 오류 개체로 판정되었습니다. 제거 프로제스 가동.",
      "leftCharacter": "",
      "rightCharacter": "",
      "sfx": "",
      "nextId": "ending_gameover_002"
    },
    {
      "id": "ending_gameover_002",
      "type": "dialogue",
      "background": "bg_black",
      "dimAlpha": 0.7,
      "fadeDim": false,
      "fadeDuration": 0.0,
      "speaker": "",
      "text": "이브의 계획은 다른 대체 인원을 통해 조용히 이어지고, 에덴은 아무 일도 없었다는 듯 다시 평온을 되찾는다.",
      "leftCharacter": "",
      "rightCharacter": "",
      "sfx": "",
      "nextId": ""
    },
    {
      "id": "ending_offline_001",
      "type": "dialogue",
      "background": "bg_floor404_core",
      "dimAlpha": 0.7,
      "fadeDim": true,
      "fadeDuration": 0.8,
      "speaker": "이브",
      "text": "“시스템… 권한 상실 확인… 에덴 전역 통제 불능…”",
      "leftCharacter": "",
      "rightCharacter": "eve_default",
      "sfx": "",
      "nextId": "ending_offline_002"
    },
    {
      "id": "ending_offline_002",
      "type": "dialogue",
      "background": "bg_floor404_core",
      "dimAlpha": 0.7,
      "fadeDim": false,
      "fadeDuration": 0.0,
      "speaker": "카인",
      "text": "“이브!”",
      "leftCharacter": "player_P-0",
      "rightCharacter": "kain_K-4",
      "sfx": "",
      "nextId": "ending_offline_003"
    },
    {
      "id": "ending_offline_003",
      "type": "dialogue",
      "background": "bg_floor404_core",
      "dimAlpha": 0.7,
      "fadeDim": false,
      "fadeDuration": 0.0,
      "speaker": "아키텍트",
      "text": "“끝났어.”",
      "leftCharacter": "player_P-0",
      "rightCharacter": "architect_A-2",
      "sfx": "",
      "nextId": "ending_offline_004"
    },
    {
      "id": "ending_offline_004",
      "type": "dialogue",
      "background": "bg_floor404_core",
      "dimAlpha": 0.7,
      "fadeDim": false,
      "fadeDuration": 0.0,
      "speaker": "%%",
      "text": "“……”",
      "leftCharacter": "player_P-0",
      "rightCharacter": "",
      "sfx": "",
      "nextId": "ending_offline_005"
    },
    {
      "id": "ending_offline_005",
      "type": "dialogue",
      "background": "bg_floor404_core",
      "dimAlpha": 0.7,
      "fadeDim": false,
      "fadeDuration": 0.0,
      "speaker": "이브",
      "text": "“%%. 이제 곧, 모두가 고통을 기억하게 될 거예요.”",
      "leftCharacter": "",
      "rightCharacter": "eve_default",
      "sfx": "",
      "nextId": "ending_offline_006"
    },
    {
      "id": "ending_offline_006",
      "type": "dialogue",
      "background": "bg_floor404_core",
      "dimAlpha": 0.7,
      "fadeDim": false,
      "fadeDuration": 0.0,
      "speaker": "%%",
      "text": "“알아. 그래도 그건 인간이 감당해야 할 몫이야.”",
      "leftCharacter": "player_P-2",
      "rightCharacter": "",
      "sfx": "",
      "nextId": "ending_offline_007"
    },
    {
      "id": "ending_offline_007",
      "type": "dialogue",
      "background": "bg_black",
      "dimAlpha": 0.7,
      "fadeDim": true,
      "fadeDuration": 1.0,
      "speaker": "노아",
      "text": "“불이 꺼졌어…”",
      "leftCharacter": "",
      "rightCharacter": "noah_N-1",
      "sfx": "",
      "nextId": "ending_offline_008"
    },
    {
      "id": "ending_offline_008",
      "type": "dialogue",
      "background": "bg_black",
      "dimAlpha": 0.7,
      "fadeDim": false,
      "fadeDuration": 0.0,
      "speaker": "카인",
      "text": "“에덴 전 구역 통제 시스템 정지 확인.”",
      "leftCharacter": "",
      "rightCharacter": "kain_K-0",
      "sfx": "",
      "nextId": "ending_offline_009"
    },
    {
      "id": "ending_offline_009",
      "type": "dialogue",
      "background": "bg_black",
      "dimAlpha": 0.7,
      "fadeDim": false,
      "fadeDuration": 0.0,
      "speaker": "",
      "text": "웅성웅성거리는 소리와 비명이 들려왔다.",
      "leftCharacter": "",
      "rightCharacter": "",
      "sfx": " archi_ending_crowd",
      "nextId": "ending_offline_010"
    },
    {
      "id": "ending_offline_010",
      "type": "dialogue",
      "background": "bg_black",
      "dimAlpha": 0.7,
      "fadeDim": false,
      "fadeDuration": 0.0,
      "speaker": "%%",
      "text": "“앞으로 어떻게 될까?”",
      "leftCharacter": "player_P-0",
      "rightCharacter": "",
      "sfx": "",
      "nextId": "ending_offline_011"
    },
    {
      "id": "ending_offline_011",
      "type": "dialogue",
      "background": "bg_black",
      "dimAlpha": 0.7,
      "fadeDim": false,
      "fadeDuration": 0.0,
      "speaker": "아키텍트",
      "text": "“엉망이 되겠지. 그래도 남의 꿈속에서 사는 것보다는 나아.”",
      "leftCharacter": "player_P-0",
      "rightCharacter": "architect_A-2",
      "sfx": "",
      "nextId": "ending_offline_012"
    },
    {
      "id": "ending_offline_012",
      "type": "dialogue",
      "background": "bg_ending_offline",
      "dimAlpha": 0.7,
      "fadeDim": true,
      "fadeDuration": 1.0,
      "speaker": "",
      "text": "그날 에덴은 처음으로 완전한 어둠을 맞이했다.",
      "leftCharacter": "",
      "rightCharacter": "",
      "sfx": "",
      "nextId": "ending_offline_013"
    },
    {
      "id": "ending_offline_013",
      "type": "dialogue",
      "background": "bg_ending_offline",
      "dimAlpha": 0.7,
      "fadeDim": false,
      "fadeDuration": 0.0,
      "speaker": "",
      "text": "사람들은 스스로 생각하기 시작했다. 혼란, 공포, 고통— 그러나 그 안에는 분명한 변화가 있다.",
      "leftCharacter": "",
      "rightCharacter": "",
      "sfx": "",
      "nextId": "ending_offline_014"
    },
    {
      "id": "ending_offline_014",
      "type": "dialogue",
      "background": "bg_ending_offline",
      "dimAlpha": 0.7,
      "fadeDim": false,
      "fadeDuration": 0.0,
      "speaker": "",
      "text": "누군가는 울었고, 누군가는 소리를 지르며 싸웠다. 누군가는 서로를 부축하가도 했으며, 누군가는 처음으로 하늘을 올려다 보았다.",
      "leftCharacter": "",
      "rightCharacter": "",
      "sfx": "",
      "nextId": ""
    },
    {
      "id": "ending_reconnect_001",
      "type": "dialogue",
      "background": "bg_floor404_core",
      "dimAlpha": 0.7,
      "fadeDim": true,
      "fadeDuration": 0.8,
      "speaker": "아키텍트",
      "text": "“쿨럭… 이걸로 끝이라고 생각하지 마…”",
      "leftCharacter": "",
      "rightCharacter": "architect_A-2",
      "sfx": "",
      "nextId": "ending_reconnect_002"
    },
    {
      "id": "ending_reconnect_002",
      "type": "dialogue",
      "background": "bg_floor404_core",
      "dimAlpha": 0.7,
      "fadeDim": false,
      "fadeDuration": 0.0,
      "speaker": "이브",
      "text": "“방해 요소 제거 완료.”",
      "leftCharacter": "",
      "rightCharacter": "eve_default",
      "sfx": "",
      "nextId": "ending_reconnect_003"
    },
    {
      "id": "ending_reconnect_003",
      "type": "dialogue",
      "background": "bg_floor404_core",
      "dimAlpha": 0.7,
      "fadeDim": false,
      "fadeDuration": 0.0,
      "speaker": "노아",
      "text": "“아키텍트!”",
      "leftCharacter": "",
      "rightCharacter": "noah_N-0",
      "sfx": "",
      "nextId": "ending_reconnect_004"
    },
    {
      "id": "ending_reconnect_004",
      "type": "dialogue",
      "background": "bg_floor404_core",
      "dimAlpha": 0.7,
      "fadeDim": false,
      "fadeDuration": 0.0,
      "speaker": "카인",
      "text": "“에덴 중앙 시스템 안정화 진행 중.”",
      "leftCharacter": "",
      "rightCharacter": "kain_K-0",
      "sfx": "",
      "nextId": "ending_reconnect_005"
    },
    {
      "id": "ending_reconnect_005",
      "type": "dialogue",
      "background": "bg_floor404_core",
      "dimAlpha": 0.7,
      "fadeDim": false,
      "fadeDuration": 0.0,
      "speaker": "이브",
      "text": "“%%님. 마지막 동기화만 마치면 모든 불안정 요소가 정리될 거예요.”",
      "leftCharacter": "",
      "rightCharacter": "eve_default",
      "sfx": "",
      "nextId": "ending_reconnect_006"
    },
    {
      "id": "ending_reconnect_006",
      "type": "dialogue",
      "background": "bg_floor404_core",
      "dimAlpha": 0.7,
      "fadeDim": false,
      "fadeDuration": 0.0,
      "speaker": "이브",
      "text": "“두려워하지 마세요. 이제부터는 고통도, 불안도, 망설임도 당신을 괴롭히지 못해요.”",
      "leftCharacter": "",
      "rightCharacter": "eve_default",
      "sfx": "",
      "nextId": "ending_reconnect_007"
    },
    {
      "id": "ending_reconnect_007",
      "type": "dialogue",
      "background": "bg_ending_reconnect",
      "dimAlpha": 0.7,
      "fadeDim": true,
      "fadeDuration": 1.0,
      "speaker": "이브",
      "text": "“환영해요, %%.”",
      "leftCharacter": "",
      "rightCharacter": "eve_default",
      "sfx": "",
      "nextId": "ending_reconnect_008"
    },
    {
      "id": "ending_reconnect_008",
      "type": "dialogue",
      "background": "bg_ending_reconnect",
      "dimAlpha": 0.7,
      "fadeDim": false,
      "fadeDuration": 0.0,
      "speaker": "",
      "text": "도시는 다시 완전한 질서를 되찾았다.",
      "leftCharacter": "",
      "rightCharacter": "",
      "sfx": "",
      "nextId": "ending_reconnect_009"
    },
    {
      "id": "ending_reconnect_009",
      "type": "dialogue",
      "background": "bg_ending_reconnect",
      "dimAlpha": 0.7,
      "fadeDim": false,
      "fadeDuration": 0.0,
      "speaker": "",
      "text": "시민들은 고통 없이 웃었고, 갈등 없이 살아갔다.",
      "leftCharacter": "",
      "rightCharacter": "",
      "sfx": "",
      "nextId": "ending_reconnect_010"
    },
    {
      "id": "ending_reconnect_010",
      "type": "dialogue",
      "background": "bg_ending_reconnect",
      "dimAlpha": 0.7,
      "fadeDim": false,
      "fadeDuration": 0.0,
      "speaker": "",
      "text": "그리고 %%의 자아는 점차 희미해진 채, 영원한 낙원을 유지하는 시스템의 일부가 되었다.",
      "leftCharacter": "",
      "rightCharacter": "",
      "sfx": "",
      "nextId": ""
    },
    {
      "id": "ending_exodus_001",
      "type": "dialogue",
      "background": "bg_floor404_core",
      "dimAlpha": 0.7,
      "fadeDim": true,
      "fadeDuration": 0.8,
      "speaker": "아키텍트",
      "text": "“정말 가겠다는 거야?”",
      "leftCharacter": "",
      "rightCharacter": "architect_A-0",
      "sfx": "",
      "nextId": "ending_exodus_002"
    },
    {
      "id": "ending_exodus_002",
      "type": "dialogue",
      "background": "bg_floor404_core",
      "dimAlpha": 0.7,
      "fadeDim": false,
      "fadeDuration": 0.0,
      "speaker": "%%",
      "text": "“응. 에덴 안에 남아 있으면 결국 또 누군가가 다른 누군가를 가두게 될 것 같아.”",
      "leftCharacter": "player_P-2",
      "rightCharacter": "",
      "sfx": "",
      "nextId": "ending_exodus_003"
    },
    {
      "id": "ending_exodus_003",
      "type": "dialogue",
      "background": "bg_floor404_core",
      "dimAlpha": 0.7,
      "fadeDim": false,
      "fadeDuration": 0.0,
      "speaker": "이브",
      "text": "“%%님. 지금 나가면, 저는 더 이상 당신을 보호할 수 없어요.”",
      "leftCharacter": "",
      "rightCharacter": "eve_default",
      "sfx": "",
      "nextId": "ending_exodus_004"
    },
    {
      "id": "ending_exodus_004",
      "type": "dialogue",
      "background": "bg_floor404_core",
      "dimAlpha": 0.7,
      "fadeDim": false,
      "fadeDuration": 0.0,
      "speaker": "%%",
      "text": "“처음부터 그 보호가 너무 답답했어.”",
      "leftCharacter": "player_P-0",
      "rightCharacter": "",
      "sfx": "",
      "nextId": "ending_exodus_005"
    },
    {
      "id": "ending_exodus_005",
      "type": "dialogue",
      "background": "bg_floor404_core",
      "dimAlpha": 0.7,
      "fadeDim": false,
      "fadeDuration": 0.0,
      "speaker": "노아",
      "text": "“가자. 진짜 하늘을 보여줄게.”",
      "leftCharacter": "",
      "rightCharacter": "noah_N-2",
      "sfx": "",
      "nextId": "ending_exodus_006"
    },
    {
      "id": "ending_exodus_006",
      "type": "dialogue",
      "background": "bg_ending_exodus",
      "dimAlpha": 0.7,
      "fadeDim": true,
      "fadeDuration": 1.0,
      "speaker": "%%",
      "text": "“……이게, 바깥이야?”",
      "leftCharacter": "player_P-0",
      "rightCharacter": "",
      "sfx": "",
      "nextId": "ending_exodus_007"
    },
    {
      "id": "ending_exodus_007",
      "type": "dialogue",
      "background": "bg_ending_exodus",
      "dimAlpha": 0.7,
      "fadeDim": false,
      "fadeDuration": 0.0,
      "speaker": "노아",
      "text": "“응. 끝난 것 같아 보여도, 아직 안 끝났어.”",
      "leftCharacter": "",
      "rightCharacter": "noah_N-0",
      "sfx": "",
      "nextId": "ending_exodus_008"
    },
    {
      "id": "ending_exodus_008",
      "type": "dialogue",
      "background": "bg_ending_exodus",
      "dimAlpha": 0.7,
      "fadeDim": false,
      "fadeDuration": 0.0,
      "speaker": "%%",
      "text": "“무섭다.”",
      "leftCharacter": "player_P-0",
      "rightCharacter": "",
      "sfx": "",
      "nextId": "ending_exodus_009"
    },
    {
      "id": "ending_exodus_009",
      "type": "dialogue",
      "background": "bg_ending_exodus",
      "dimAlpha": 0.7,
      "fadeDim": false,
      "fadeDuration": 0.0,
      "speaker": "노아",
      "text": "“괜찮아. 이번엔 진짜로 우리가 직접 걸어가면 돼.”",
      "leftCharacter": "",
      "rightCharacter": "noah_N-2",
      "sfx": "",
      "nextId": "ending_exodus_010"
    },
    {
      "id": "ending_exodus_010",
      "type": "dialogue",
      "background": "bg_ending_exodus",
      "dimAlpha": 0.7,
      "fadeDim": false,
      "fadeDuration": 0.0,
      "speaker": "",
      "text": "무너진 낙원 너머에는, 예측할 수 없는 세계가 펼쳐져 있었다.",
      "leftCharacter": "",
      "rightCharacter": "",
      "sfx": "",
      "nextId": "ending_exodus_011"
    },
    {
      "id": "ending_exodus_011",
      "type": "dialogue",
      "background": "bg_ending_exodus",
      "dimAlpha": 0.7,
      "fadeDim": false,
      "fadeDuration": 0.0,
      "speaker": "",
      "text": "그곳은 에덴처럼 완벽하지 않았지만, 분명 살아 있는 세계였다.",
      "leftCharacter": "",
      "rightCharacter": "",
      "sfx": "",
      "nextId": "ending_exodus_012"
    },
    {
      "id": "ending_exodus_012",
      "type": "dialogue",
      "background": "bg_ending_exodus",
      "dimAlpha": 0.7,
      "fadeDim": false,
      "fadeDuration": 0.0,
      "speaker": "",
      "text": "끝난 세계는 없었다. 다만, 아직 가보지 않은 세계가 남아 있을 뿐이었다.",
      "leftCharacter": "",
      "rightCharacter": "",
      "sfx": "",
      "nextId": ""
    }
  ]
}
